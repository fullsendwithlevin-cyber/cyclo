# ── Pflicht ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://assistant:assistant@localhost:5432/assistant"
APP_URL="http://localhost:3000"
# 32 Byte, Base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Entwicklungs-Login ohne OAuth (nie in Produktion; wird dort ignoriert)
ALLOW_DEV_LOGIN="true"

# ── KI-Provider ──────────────────────────────────────────────────────────
AI_PROVIDER="anthropic"            # anthropic | openai
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
ANTHROPIC_EFFORT="high"            # low | medium | high | xhigh | max
ANTHROPIC_FALLBACKS="true"         # serverseitige Refusal-Fallbacks
OPENAI_API_KEY=""                  # optional: Embeddings (semantische Suche) + Spracherkennung
OPENAI_MODEL="gpt-5"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_TRANSCRIBE_MODEL="gpt-4o-transcribe"

# ── Google (Login, Calendar, Gmail, Drive) ───────────────────────────────
# Redirect-URI in der Google Cloud Console: ${APP_URL}/api/oauth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Microsoft (OneNote über Graph) ───────────────────────────────────────
# Redirect-URI im Entra-App-Registrierung: ${APP_URL}/api/oauth/callback/microsoft
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"

# ── Optional ─────────────────────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=""            # Websuche für den Agenten
# Web-Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:du@example.com"
# E-Mail-Benachrichtigungen, z. B. smtps://user:pass@smtp.example.com:465
SMTP_URL=""
SMTP_FROM=""
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB="25"
CRON_SECRET=""                     # für POST /api/cron (serverlose Scheduler)
BROWSER_EXECUTABLE_PATH=""         # Chromium für Browser-Tools, falls nicht Standard
WORKER_CONCURRENCY="3"
